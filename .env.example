APP_ENV=development
DEBUG=0

# Local: deixe DATABASE_URL vazio para usar SQLite em trilha_tjs_ajaa.db.
# Produção: informe a URL PostgreSQL fornecida pela plataforma.
DATABASE_URL=

ESTUDOS_DB=trilha_tjs_ajaa.db
ESTUDOS_ADMIN_EMAIL=admin@admin.com
ESTUDOS_ADMIN_PASSWORD=troque-esta-senha-antes-do-deploy

# Opcional: planilha de referência.
# Vazio = Acompanhamento_da_Trilha.xlsx na pasta do app.
# Caminho relativo resolve a partir da pasta do app; absoluto é usado como veio.
# Ex.: ESTUDOS_REFERENCIA=C:\Users\seu-usuario\Downloads\Acompanhamento da Trilha - TJs - AJAA.xlsx
ESTUDOS_REFERENCIA=
